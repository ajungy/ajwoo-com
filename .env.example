# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:4321
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/ajwoo/30min

# Checkout adapter. Provider is undecided (CLAUDE.md D2) — leave blank to render
# the guarded purchase action in its unconfigured state. TEST KEYS ONLY.
NEXT_PUBLIC_CHECKOUT_PROVIDER=
NEXT_PUBLIC_CHECKOUT_BASE_URL=

# Shared PostHog project token (public ingestion token, never a personal API key).
# Blank disables analytics. Production AJWOO hostnames only; no localhost traffic.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
